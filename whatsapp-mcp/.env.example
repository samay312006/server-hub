# Copy to .env and fill in. Used for INCOMING WhatsApp chatbot replies and the
# /grok and /gemini auto-replies. Without a key, incoming /claude is ignored.
#
# Groq (recommended - free, fast): get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (optional fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Primary Google Calendar account used by the /calendar add command (optional)
PRIMARY_CALENDAR_ACCOUNT=
