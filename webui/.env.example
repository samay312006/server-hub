# Copy to .env and adjust. The setup script generates a real .env for you.
HUB_PORT=8088
HUB_BIND=0.0.0.0
# Login password for the web UI. If blank, a random one is printed at startup.
HUB_PASSWORD=
# Model alias (opus, sonnet, haiku) or full id. Matches your claude default.
HUB_MODEL=opus
# Directory claude runs in (where it has file access + reads .mcp.json in Phase 4).
HUB_WORKDIR=C:\server-hub
# bypassPermissions lets MCP/tools run without interactive prompts (needed headless).
HUB_PERMISSION_MODE=bypassPermissions
# Safety ceiling per turn (ms).
HUB_TURN_TIMEOUT_MS=600000

# ---- Multi-device (Tailscale) ----
# Informational role: 'hub' = the always-on node browsers point at; 'agent' = a peer.
HUB_ROLE=hub
# Stable id for this node (defaults to hostname). Must match its entry in devices.json.
HUB_DEVICE_ID=
# Shared secret the hub uses to reach peers' /agent/* surface. Set the SAME value
# on every node. If blank, cross-device control is disabled (local-only).
HUB_DEVICE_TOKEN=
