# Port for the control HTTP API
PRICE_TRACKER_PORT=8095

# How often to check prices (minutes). Default: 30
PRICE_CHECK_INTERVAL_MINUTES=30

# WhatsApp control API (whatsapp-mcp daemon)
WA_CONTROL_URL=http://127.0.0.1:8091

# Owner WhatsApp chat ID to receive drop alerts (e.g. 91XXXXXXXXXX@c.us)
OWNER_CHAT_ID=
