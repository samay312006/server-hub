# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" for "Desktop app" type.
# Enable the Gmail API first: APIs & Services → Library → Gmail API → Enable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Accounts ──────────────────────────────────────────────────────────────────
# Comma-separated Gmail accounts to monitor. After adding entries here,
# run: node setup.js add <email> for each one to authorize via browser.
GMAIL_ACCOUNTS=

# ── WhatsApp integration ──────────────────────────────────────────────────────
# The WhatsApp daemon control API (keep in sync with WA_CONTROL_PORT)
WA_CONTROL_URL=http://127.0.0.1:8091

# Your personal WhatsApp chat ID (where digests are sent).
# Find it by running /claude-status in WhatsApp or ask: /claude what is my chat id?
OWNER_CHAT_ID=

# ── Summarization keys (reuse from whatsapp-mcp/.env if you have them) ────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=15

# ── Classifier config ─────────────────────────────────────────────────────────
# Partial email addresses that always trigger a notification (comma-separated)
SENDER_WHITELIST=

# Subject-line keywords that flag an email as important (comma-separated)
IMPORTANT_KEYWORDS=urgent,important,deadline,interview,offer letter,result,admit card,selected,rejected,payment,otp,verification,action required,verify,confirm,due date,overdue,expiring

# ── Control API ───────────────────────────────────────────────────────────────
GMAIL_MONITOR_PORT=8093
